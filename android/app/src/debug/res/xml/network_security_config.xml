<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config. Android automatically uses this file
  instead of main/res/xml/network_security_config.xml for debug builds
  (source-set overlay by build type — no gradle wiring needed).

  This is where the cleartext-HTTP exception for your local backend
  (shared/config.js's ACTIVE_BACKEND='local' IP) belongs — NOT in
  main/res/xml, which now ships secure-by-default (HTTPS-only) in every
  release build. Edit the IP below to match your machine's current LAN
  IP whenever you test against a locally-run backend.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.215.18.30</domain>
    </domain-config>
</network-security-config>
